# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
.Python
pip-wheel-metadata/

# ── Virtual environments ───────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/
.env
.env.*

# ── Secrets and credentials ────────────────────────────────────────────────────
*.pem
*.key
*.p12
secrets.json
credentials.json

# ── Runtime databases (generated at startup) ──────────────────────────────────
data/
*.db
*.sqlite
*.sqlite3

# ── Generated datasets (reproducible from scripts/generate_dataset.py) ────────
*.csv
*.parquet
*.jsonl
data_quality_report.json

# exports/ is the one exception: it holds the small, seeded (n=5000,
# seed=42), reproducible analytics fixture written by
# scripts/build_analytics_dataset.py (~160KB total) -- committed
# intentionally so Power BI / the Streamlit Analytics tab has something
# to load without requiring a ~1 minute pipeline run first. Do NOT widen
# this to a full 500K-transaction export -- regenerate locally instead.
!exports/
!exports/*.csv

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log
logs/

# ── Testing ───────────────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
.tox/

# ── Type checking / linting ───────────────────────────────────────────────────
.mypy_cache/
.ruff_cache/

# ── Editor / OS ───────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ── Jupyter ───────────────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ── Streamlit ─────────────────────────────────────────────────────────────────
.streamlit/

# ── Docker ────────────────────────────────────────────────────────────────────
*.tar

# ── Miscellaneous ─────────────────────────────────────────────────────────────
tmp/
temp/
scratch/
